# Copier en `.env` à la racine (lu automatiquement par docker compose).
# Ne jamais committer `.env`.

# --- PostgreSQL (compose.yaml) ---
POSTGRES_USER=pousse
POSTGRES_PASSWORD=pousse
POSTGRES_DB=pousse
POSTGRES_PORT=5432

# --- API (apps/api/src/shared/config/env.ts) ---
PORT=3000
DATABASE_URL=postgres://pousse:pousse@localhost:5432/pousse
