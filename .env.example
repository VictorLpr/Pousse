# Copy to `.env` at the repo root (read automatically by docker compose).
# Never commit `.env`.

# --- PostgreSQL (compose.yaml) ---
POSTGRES_USER=pousse
POSTGRES_PASSWORD=pousse
POSTGRES_DB=pousse
POSTGRES_PORT=5432

# --- API ---
# Port exposed on the host by compose.yaml
API_PORT=3000
# Inside Docker, DATABASE_URL is built by compose.yaml (host `db`).
# This value is only used by commands run from the host
# (e.g. `npm run db:generate -w apps/api`).
DATABASE_URL=postgres://pousse:pousse@localhost:5432/pousse

# --- Authentication (BetterAuth, ADR-0003) ---
# Session cookie signing key, at least 32 characters.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-secret-never-use-outside-local
# Public origin of the application, without a path (no /api).
BETTER_AUTH_URL=http://localhost:3000
