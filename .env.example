# Copier en `.env` à la racine (lu automatiquement par docker compose).
# Ne jamais committer `.env`.

# --- PostgreSQL (compose.yaml) ---
POSTGRES_USER=pousse
POSTGRES_PASSWORD=pousse
POSTGRES_DB=pousse
POSTGRES_PORT=5432

# --- API ---
# Port exposé sur l'hôte par compose.yaml
API_PORT=3000
# Dans Docker, DATABASE_URL est construite par compose.yaml (hôte `db`).
# Cette valeur ne sert qu'aux commandes lancées depuis l'hôte
# (ex. `npm run db:generate -w apps/api`).
DATABASE_URL=postgres://pousse:pousse@localhost:5432/pousse
