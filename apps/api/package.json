{
  "name": "@pousse/api",
  "version": "0.0.0",
  "private": true,
  "imports": {
    "#/*": {
      "development": "./src/*",
      "default": "./dist/*"
    }
  },
  "scripts": {
    "dev": "tsx watch --conditions=development src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/swagger": "^9.4.0",
    "better-auth": "^1.2.0",
    "drizzle-orm": "^0.36.0",
    "fastify": "^5.2.0",
    "fastify-type-provider-zod": "^4.0.0",
    "pino": "^9.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "drizzle-kit": "^0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2"
  }
}
