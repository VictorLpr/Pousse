// Cloudflare Worker that serves the PWA (Expo static export) and forwards
// /api/* to the Scaleway API, so the web app and the API share the same
// origin. See docs/adr/0011-hebergement-et-deploiement.md.
//
// API_ORIGIN is not inherited by environments: CI passes it with
// `--var API_ORIGIN:<url>` from the GitHub environment secret.
{
  "name": "pousse-web-local",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  // Local development: `npx wrangler dev` forwards to `docker compose up`.
  "vars": {
    "API_ORIGIN": "http://localhost:3000",
  },
  "env": {
    "staging": {
      "name": "pousse-web-staging",
      "workers_dev": true,
      "preview_urls": false,
    },
    "production": {
      "name": "pousse-web",
      "workers_dev": true,
      "preview_urls": false,
    },
  },
}
